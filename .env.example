# 作用：运行环境标识。开发时使用 development，ECS 部署时使用 production。
APP_ENV=development

# 作用：网关监听地址和端口。
GATEWAY_HOST=127.0.0.1
GATEWAY_PORT=8000

# 作用：上游大模型的 OpenAI 兼容接口地址。
# 后续根据 DeepSeek、Qwen 或其他模型平台的实际地址调整。
LLM_BASE_URL=https://api.deepseek.com

# 作用：上游大模型名称。
LLM_MODEL=deepseek-chat

# 作用：真实密钥只能写入本机 .env 或 ECS 的 .env，禁止写入此文件。
LLM_API_KEY=replace-with-your-api-key

# 作用：本地 Embedding 模型目录。
# 需要先运行 bash scripts/download_embedding_model.sh 下载 ONNX 模型。
EMBEDDING_MODEL_PATH=./models/multilingual-e5-small

# 作用：ONNX 推理线程数；按 CPU 核数设置。
EMBEDDING_THREADS=2

# 作用：语义缓存命中所需的最低相似度。
VECTOR_STORE_PATH=./data/chroma
CACHE_SIMILARITY_THRESHOLD=0.92

# 作用：缓存有效期，单位为秒；86400 即 24 小时。
CACHE_TTL_SECONDS=86400

# 作用：网关共享令牌（必填，部署到公网机器时）。
# 网关持有上游大模型的 API Key，不设令牌等于把 Key 借给任何扫到端口的人。
# 生成方式：openssl rand -hex 32
# 本地开发可留空（此时不校验并会在启动日志里警告）。
GATEWAY_AUTH_TOKEN=

# 作用：技术雷达通过该地址调用网关。
# Docker 部署时会改为 http://gateway:8000。
GATEWAY_BASE_URL=http://127.0.0.1:8000

# 作用：每条来源最多抓取多少条。3 个来源 × 该数值 = 单轮采集条目上限。
RADAR_ITEM_LIMIT=10

# 作用：定时采集间隔，单位为分钟；360 即每 6 小时一次。
RADAR_INTERVAL_MINUTES=360

# 作用：是否启用定时采集。本地调试或跑测试时可设为 false。
RADAR_SCHEDULER_ENABLED=true

# 作用：构建镜像时使用的 PyPI 源。仅影响 docker compose build，不影响运行时。
# 国内主机（如阿里云 ECS）建议改为 https://pypi.tuna.tsinghua.edu.cn/simple
PIP_INDEX_URL=https://pypi.org/simple

# 作用：采集器出网用的 HTTP 代理。留空即直连。
# 只注入给 radar 服务；网关不经过代理（它调的是国内可达的大模型接口）。
# 实测：阿里云北京直连 V2EX 超时、直连 GitHub Trending 概率性超时，两者都必须走代理。
# 例：COLLECTOR_HTTP_PROXY=http://<代理主机>:7890
COLLECTOR_HTTP_PROXY=
