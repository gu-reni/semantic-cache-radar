# 作用：运行环境标识。开发时使用 development，ECS 部署时使用 production。
APP_ENV=development

# 作用：网关监听地址和端口。
GATEWAY_HOST=127.0.0.1
GATEWAY_PORT=8000

# 作用：上游大模型的 OpenAI 兼容接口地址。
# 后续根据 DeepSeek、Qwen 或其他模型平台的实际地址调整。
LLM_BASE_URL=https://api.deepseek.com

# 作用：上游大模型名称。
LLM_MODEL=deepseek-chat

# 作用：真实密钥只能写入本机 .env 或 ECS 的 .env，禁止写入此文件。
LLM_API_KEY=replace-with-your-api-key

# 作用：本地 Embedding 模型目录。
EMBEDDING_MODEL_PATH=./models/multilingual-e5-small

# 作用：语义缓存命中所需的最低相似度。
VECTOR_STORE_PATH=./data/chroma
CACHE_SIMILARITY_THRESHOLD=0.92

# 作用：缓存有效期，单位为秒；86400 即 24 小时。
CACHE_TTL_SECONDS=86400

# 作用：技术雷达通过该地址调用网关。
# Docker 部署时会改为 http://gateway:8000。
GATEWAY_BASE_URL=http://127.0.0.1:8000
