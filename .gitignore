# 作用：忽略项目独立 Python 环境；依赖会通过 requirements.txt 重建。
.venv/

# 作用：忽略 Python 编译缓存和测试工具生成的临时文件。
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/

# 作用：忽略 API Key、模型地址等本机或服务器私密配置。
.env
.env.*
!.env.example

# 作用：忽略本地下载的 Embedding 模型，避免仓库过大。
models/

# 作用：忽略 ChromaDB 向量缓存和 SQLite 运行数据。
data/
chroma_data/
*.db
*.sqlite
*.sqlite3

# 作用：忽略日志与编辑器配置。
*.log
.vscode/
.idea/

# 作用：忽略系统生成的文件。
.DS_Store
Thumbs.db